      "lines": [
        {
          "id": "story_01_001",
          "speaker": "narrator",
          "text": "Once upon a time there was a golden cookie. He was just like all his friends. Just a little bit more ... golden.",
          "audio": "assets/voicelines/conversation_01/big_01.wav",
          "expression": "neutral"
        },
        {
          "id": "story_01_002",
          "speaker": "cookie_one",
          "text": "It’s fun.",
          "audio": "assets/voicelines/conversation_01/small_01.wav",
          "expression": "happy"
        },
        {
          "id": "story_01_003",
          "speaker": "cookie_two",
          "text": "A funny game.",
          "audio": "assets/voicelines/conversation_01/big_02.wav",
          "expression": "happy"
        },
        {
          "id": "story_01_004",
          "speaker": "cookie_three",
          "text": "It's so nice to be around him.",
          "audio": "assets/voicelines/conversation_01/small_01.wav",
          "expression": "happy"
        },
        {
          "id": "story_01_005",
          "speaker": "chorus",
          "text": "Ringel, Ringel, rounded,",
          "audio": "assets/voicelines/conversation_01/big_02.wav",
          "expression": "happy"
        },
        {
          "id": "story_01_006",
          "speaker": "chorus",
          "text": "we all liberated,",
          "audio": "assets/voicelines/conversation_01/small_01.wav",
          "expression": "happy"
        },
        {
          "id": "story_01_007",
          "speaker": "chorus",
          "text": "dancing ‘round the golden one,",
          "audio": "assets/voicelines/conversation_01/big_02.wav",
          "expression": "thrilled"
        },
        {
          "id": "story_01_008",
          "speaker": "chorus",
          "text": "Everybody shoo, shoo, shoo.",
          "audio": "assets/voicelines/conversation_01/small_01.wav",
