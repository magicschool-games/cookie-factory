          "expression": "happy"
        },
        {
          "id": "story_01_012",
          "speaker": "chorus",
          "text": "cookies lov’s him lot, lot, lot. ",
          "audio": "assets/voicelines/conversation_01/big_02.wav",
          "expression": "happy"
