    "conversation_02": {
      "kind": "story_sequence",
      "playback": "sequential",
      "trigger_event": null,
      "skippable": true,
      "lines": [
        {
          "id": "story_02_001",
          "speaker": "whole_cookie",
          "text": "But we just escaped. Broke free from Santas enslavement. How … how could he … do that?",
          "audio": "assets/voicelines/conversation_02/big_01.wav",
          "expression": "worried"
        },
        {
          "id": "story_02_002",
          "speaker": "small_cookie",
          "text": "But he IS our friend. That must be some sort of misunderstanding. Maybe if we just ask him?",
          "audio": "assets/voicelines/conversation_02/small_01.wav",
          "expression": "worried"
        },
        {
          "id": "story_02_003",
          "speaker": "big_cookie",
          "text": "No, he can’t be trusted.",
          "audio": "assets/voicelines/conversation_02/big_02.wav",
          "expression": "skeptical"
        },
        {
          "id": "story_02_004",
          "speaker": "small_cookie",
          "text": "But…",
          "audio": "assets/voicelines/conversation_02/small_01.wav",
          "expression": "worried"
        },
        {
          "id": "story_02_005",
          "speaker": "big_cookie",
          "text": "No. He. Can’t. Be. Trusted. ",
          "audio": "assets/voicelines/conversation_02/big_02.wav",
          "expression": "angry"
        },
        {
          "id": "story_02_006",
          "speaker": "big_cookie",
          "text": "I just can’t trust anyone. Not even myself. I better leave this place!",
          "audio": "assets/voicelines/conversation_02/small_01.wav",
          "expression": "worried"
        },
        {
          "id": "story_02_007",
          "speaker": "big_cookie",
          "text": "Into freedom!",
          "audio": "assets/voicelines/conversation_02/big_02.wav",
          "expression": "thrilled"
        }
      ]
    }
  },
